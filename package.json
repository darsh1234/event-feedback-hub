{
  "name": "event-feedback-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,web \"npm run dev --workspace @event-feedback-hub/server\" \"npm run dev --workspace @event-feedback-hub/web\"",
    "setup": "npm run setup --workspace @event-feedback-hub/server",
    "codegen": "graphql-codegen --config codegen.yml",
    "build": "npm run codegen && npm run build --workspaces --if-present",
    "typecheck": "npm run codegen && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run codegen && npm run format:check && npm run lint && npm run typecheck --workspaces --if-present && npm run test && npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false,
    "better-sqlite3@13.0.3": true,
    "@apollo/protobufjs": false
  }
}
